{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: Refresh IntelliSense",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/refresh-intellisense.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Arduino: Build ESP32-S3",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/refresh-intellisense.ps1", "-Build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
